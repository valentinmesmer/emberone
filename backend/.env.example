# Used by support/dev/setup.sh (backend). Empty values are secrets and get generated.

SPRINGDOC_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
OAUTH2_ISSUER_URI=http://localhost:9000/application/o/emberone/
OAUTH2_AUDIENCES=emberone
DATASOURCE_URL=jdbc:postgresql://localhost:5432/emberone
DATASOURCE_USERNAME=emberone_app
DATASOURCE_PASSWORD=
FLYWAY_USERNAME=emberone_migrator
FLYWAY_PASSWORD=
AUTHENTIK_API_BASE_URL=http://localhost:9000
AUTHENTIK_API_TOKEN=
EMBERONE_APP_PUBLIC_BASE_URL=http://localhost:3000
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_ACCESS_KEY=emberone-local
OBJECT_STORAGE_SECRET_KEY=
# Local Mailpit (http://localhost:8025): no auth, no TLS.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=noreply@emberone.localhost
MAIL_PASSWORD=unused
MAIL_SMTP_AUTH=false
MAIL_SMTP_START_TLS=false
MAIL_FROM_NAME=EmberOne
