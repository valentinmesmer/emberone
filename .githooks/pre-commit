set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

frontend_files=()
java_files=()

while IFS= read -r -d '' file; do
  case "$file" in
    frontend/*)
      case "$file" in
        *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.css|*.json)
          frontend_files+=("$file")
          ;;
      esac
      ;;
  esac
  if [[ "$file" == backend/*.java ]]; then
    java_files+=("$file")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#frontend_files[@]} -gt 0 ]]; then
  biome="$ROOT/frontend/node_modules/.bin/biome"
  if [[ ! -x "$biome" ]]; then
    echo "Frontend dependencies missing. Run: cd frontend && bun install" >&2
    exit 1
  fi
  rel_files=()
  for file in "${frontend_files[@]}"; do
    rel_files+=("${file#frontend/}")
  done
  (
    cd "$ROOT/frontend"
    "$biome" format --write -- "${rel_files[@]}"
  )
  git add -- "${frontend_files[@]}"
fi

if [[ ${#java_files[@]} -gt 0 ]]; then
  if [[ ! -x "$ROOT/backend/gradlew" ]]; then
    echo "backend/gradlew is missing or not executable." >&2
    exit 1
  fi
  patterns=()
  for file in "${java_files[@]}"; do
    abs="$ROOT/$file"
    escaped="$(printf '%s' "$abs" | sed -e 's/[.\\^$*+?()[\]{}|]/\\&/g')"
    patterns+=("$escaped")
  done
  IFS=','
  (
    cd "$ROOT/backend"
    ./gradlew --quiet spotlessApply "-PspotlessFiles=${patterns[*]}"
  )
  unset IFS
  git add -- "${java_files[@]}"
fi
